diff --git a/qemu/tcg/i386/tcg-target.inc.c b/qemu/tcg/i386/tcg-target.inc.c
index 15cc1c0..0c7ff00 100644
--- a/qemu/tcg/i386/tcg-target.inc.c
+++ b/qemu/tcg/i386/tcg-target.inc.c
@@ -3667,6 +3667,10 @@ static const int tcg_target_callee_save_regs[] = {
 static void tcg_target_qemu_prologue(TCGContext *s)
 {
     int i, stack_addend;
+#if defined(_WIN64) && defined(_MSC_VER)
+    uint8_t push_offsets[ARRAY_SIZE(tcg_target_callee_save_regs)];
+    uint8_t *prologue_begin = s->code_ptr;
+#endif
 
     /* TB prologue */
 
@@ -3678,6 +3682,9 @@ static void tcg_target_qemu_prologue(TCGContext *s)
     /* Save all callee saved registers.  */
     for (i = 0; i < ARRAY_SIZE(tcg_target_callee_save_regs); i++) {
         tcg_out_push(s, tcg_target_callee_save_regs[i]);
+#if defined(_WIN64) && defined(_MSC_VER)
+        push_offsets[i] = (uint8_t)(s->code_ptr - prologue_begin);
+#endif
     }
 
 #if TCG_TARGET_REG_BITS == 32
@@ -3691,6 +3698,32 @@ static void tcg_target_qemu_prologue(TCGContext *s)
 #else
     tcg_out_mov(s, TCG_TYPE_PTR, TCG_AREG0, tcg_target_call_iarg_regs[0]);
     tcg_out_addi(s, TCG_REG_ESP, -stack_addend);
+#if defined(_WIN64) && defined(_MSC_VER)
+    {
+        /* Windows can now unwind a generated TB back to cpu_exec's native
+         * setjmp frame. Entries describe the actual emitted pushes/allocation. */
+        uint8_t *base = s->initial_buffer;
+        PRUNTIME_FUNCTION entry = (PRUNTIME_FUNCTION)base;
+        uint8_t *info = base + 32;
+        unsigned count = ARRAY_SIZE(tcg_target_callee_save_regs);
+        unsigned slot = 2;
+        info[0] = 1; /* UNWIND_INFO version 1, no handler */
+        info[1] = (uint8_t)(s->code_ptr - prologue_begin);
+        info[2] = (uint8_t)(count + 2);
+        info[3] = 0;
+        info[4] = info[1]; info[5] = 1; /* UWOP_ALLOC_LARGE */
+        *(uint16_t *)(info + 6) = (uint16_t)(stack_addend / 8);
+        for (i = (int)count - 1; i >= 0; --i, ++slot) {
+            info[4 + slot * 2] = push_offsets[i];
+            info[5 + slot * 2] = (uint8_t)(tcg_target_callee_save_regs[i] << 4);
+        }
+        entry->BeginAddress = (DWORD)(prologue_begin - base);
+        entry->EndAddress = (DWORD)s->initial_buffer_size;
+        entry->UnwindData = 32;
+        if (!RtlAddFunctionTable(entry, 1, (DWORD64)base)) abort();
+        s->win_unwind_table = entry;
+    }
+#endif
     /* jmp *tb.  */
     tcg_out_modrm(s, OPC_GRP5, EXT5_JMPN_Ev, tcg_target_call_iarg_regs[1]);
 #endif
diff --git a/qemu/tcg/tcg.c b/qemu/tcg/tcg.c
index bc62051..9d7dde0 100644
--- a/qemu/tcg/tcg.c
+++ b/qemu/tcg/tcg.c
@@ -831,6 +831,14 @@ void tcg_prologue_init(TCGContext *s)
     /* Put the prologue at the beginning of code_gen_buffer.  */
     buf0 = s->code_gen_buffer;
     total_size = s->code_gen_buffer_size;
+#if defined(_WIN64) && defined(_MSC_VER)
+    /* Reserve native unwind metadata before any generated instructions. */
+    memset(buf0, 0, 256);
+    buf0 = (char *)buf0 + 256;
+    total_size -= 256;
+    s->code_gen_buffer = buf0;
+    s->code_gen_buffer_size = total_size;
+#endif
     s->code_ptr = buf0;
     s->code_buf = buf0;
     s->data_gen_ptr = NULL;
